# ===========================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and update with your values
# For production, create .env.prod with strong passwords

# ===========================================
# JWT Configuration
# ===========================================
# Secret key for JWT token signing (MUST be at least 256 bits for HS256)
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-secret-key-at-least-256-bits-replace-this-in-production-use-openssl-rand-base64-64-to-generate

# Access token expiration time in milliseconds (default: 24 hours)
JWT_EXPIRATION=86400000

# Refresh token expiration time in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION=604800000

# ===========================================
# MySQL Database Configuration
# ===========================================
# Root password for MySQL (use strong password in production)
MYSQL_ROOT_PASSWORD=root_password

# Database name
MYSQL_DATABASE=library_db

# Database user
MYSQL_USER=library_user

# Database password (use strong password in production)
MYSQL_PASSWORD=library_pass

# ===========================================
# Spring Boot Configuration (Optional)
# ===========================================
# Active profile: dev, test, or prod
# SPRING_PROFILES_ACTIVE=dev

# Server port (default: 8081)
# SERVER_PORT=8081

# Database connection URL (auto-generated if not set)
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/library_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Database username (uses MYSQL_USER if not set)
# SPRING_DATASOURCE_USERNAME=library_user

# Database password (uses MYSQL_PASSWORD if not set)
# SPRING_DATASOURCE_PASSWORD=library_pass
